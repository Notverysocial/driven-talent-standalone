# Driven Talent — Supabase
# Copy to .env.local and fill in. The app reads server-side via NEXT_PUBLIC_SUPABASE_URL
# and the anon key. Service-role key is needed for server actions that bypass RLS
# (e.g. seeding from the app, admin-only fixes, /access user invites). Keep it
# server-side only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin of this deployment. Used as the base for Supabase Auth
# email-link redirects (invite, password reset, magic link → /auth/callback).
# Leave unset in dev; falls back to http://localhost:3000.
# Set to e.g. https://driven-talent.vercel.app in Vercel project env.
NEXT_PUBLIC_SITE_URL=

# Wave 3.1 auth + RBAC gate. Default OFF: the app runs auth-disabled and
# every request is treated as the synthetic Owner (open v1 UX). Flip to
# "true" to require sign-in via /login and enforce owner/admin/user
# role tiers across the app. Do NOT flip on until real users are
# invited via /access and the team is ready to switch over.
AUTH_ENABLED=false
