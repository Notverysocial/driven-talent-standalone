# Driven Talent — Supabase
# Copy to .env.local and fill in. The app reads server-side via NEXT_PUBLIC_SUPABASE_URL
# and the anon key. Service-role key is only needed for server actions that bypass RLS
# (e.g. seeding from the app, admin-only fixes). Keep it server-side only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
